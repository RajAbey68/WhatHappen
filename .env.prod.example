# Production .env for hermes-dev deployment
# Copy to .env.prod on the host and pass to docker-compose

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pomgvxdokjmxyfbgazls.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from Supabase dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard, KEEP SECRET>

# ── OpenRouter (LLM gateway) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=<from openrouter.ai/keys>

# ── Passphrase Gate (RAJ-747) ─────────────────────────────────────────────────
# SHA-256 hash of the global passphrase (server-side only, never exposed to client)
# Generate with: printf '%s' "$PASSPHRASE" | shasum -a 256 | awk '{print $1}'
WHATSAPP_PASSPHRASE_HASH=<generate with above command>

# ── Session Management ─────────────────────────────────────────────────────────
# Random 32+ character string for session encryption
APP_SESSION_SECRET=<generate with: openssl rand -hex 32>

# ── Deep Research API ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=<optional, for enhanced analysis>

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://whathappen.internal.hermes.local
ARCHIVE_DAYS=7
